{
  "name": "jev-keep-up",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.cjs",
    "build:static": "npm run build",
    "build:local": "tsc --noEmit && vite build --mode dual",
    "preview:local": "vite preview --outDir dist-local",
    "test:compile": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  }
}
